# 复制为 .env，仅用于本机 Docker Compose。不要提交真实密码。
MYSQL_DATABASE=inspiration_assistant
MYSQL_USER=inspiration
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
MINIO_ROOT_USER=knowledge-local-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# FIXTURE 只允许测试；本机交互学习建议使用 LOCAL，或配置 REMOTE Provider。
RAG_PROVIDER_MODE=DISABLED
RAG_EMBEDDING_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=
RAG_LLM_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
