APP_NAME=日常灵感智能助手
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://inspiration:change-me@127.0.0.1:3306/inspiration_assistant?charset=utf8mb4
# 必须替换：使用密码学安全随机源生成至少 32 字节的高熵值。
# 此占位值会被程序主动拒绝，禁止提交真实密钥。
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# 可选 AI Provider；为空时启用确定性中文 fallback
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# P8 Agent Worker 以独立进程运行：python -m app.workers.agent
AGENT_DISPATCH_POLL_SECONDS=1
AGENT_DISPATCH_CLAIM_LIMIT=4
AGENT_DISPATCH_LEASE_SECONDS=30
AGENT_DISPATCH_RENEW_SECONDS=10
AGENT_DISPATCH_MAX_ATTEMPTS=5
AGENT_APPROVAL_TTL_SECONDS=900
AGENT_WORKER_INSTANCE_ID=

# MCP stdio 仅限可信本机进程；工具调用必须同时匹配以下身份和令牌
MCP_USER_ID=
MCP_LOCAL_TOKEN=

# P2 可选依赖。缺失时 development/test 使用显式 Fake；生产环境不会静默降级为 Fake。
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_SOURCE_BUCKET=knowledge-source
MINIO_DERIVED_BUCKET=knowledge-derived
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
EXTERNAL_STORAGE_TIMEOUT_SECONDS=5

# REMOTE/LOCAL 适配器没有配置完整前会明确失败；FIXTURE 只用于测试/开发回归。
RAG_PROVIDER_MODE=DISABLED
RAG_EMBEDDING_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
# ALIBABA_QWEN3 示例基址：https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-api/v1
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=
RAG_RERANKER_PROFILE=OPENAI_COMPATIBLE
# 相对 RAG_RERANKER_URL 的可选路径；ALIBABA_QWEN3 默认使用 reranks。
RAG_RERANKER_ENDPOINT=
RAG_LLM_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
RAG_LLM_PROFILE=OPENAI_JSON_SCHEMA
RAG_SYNC_INGESTION_ENABLED=false
RAG_MAX_UPLOAD_MIB=50
RAG_EVIDENCE_MIN_SCORE=0.015
RAG_EVIDENCE_MIN_LEXICAL_COVERAGE=0.2
